{
  "title": "Advanced Pattern Language Feature Tests",
  "tests": {
    "12_complex_layers_structure": {
      "title": "Complex Layers with Multiple BasePattern+Variations",
      "description": "Test the full layers structure with multiple instruments using basePattern+variations like My Girl",
      "tempo": 100,
      "chords": {
        "C": ["C3", "E3", "G3", "C4"],
        "F": ["F3", "A3", "C4", "F4"],
        "G": ["G3", "B3", "D4", "G4"]
      },
      "patterns": {
        "melody_base": [
          [1.0, "C4", 0.7, 0.5],
          [2.0, "E4", 0.6, 0.5],
          [3.0, "G4", 0.7, 0.5],
          [4.0, "C4", 0.6, 0.5]
        ],
        "melody_variation": [
          [1.0, "D4", 0.8, 0.5],
          [2.0, "F4", 0.7, 0.5],
          [3.0, "A4", 0.8, 1.0]
        ],
        "bass_walking": [
          [1.0, {"tone": 1, "octave": 2}, 0.7, 1.0],
          [2.0, {"tone": 3, "octave": 2}, 0.6, 1.0],
          [3.0, {"tone": 5, "octave": 2}, 0.7, 1.0],
          [4.0, {"tone": 1, "octave": 3}, 0.6, 1.0]
        ],
        "chord_stabs": [
          [1.0, {"chord": "C"}, 0.5, 2.0],
          [3.0, {"chord": "F"}, 0.5, 2.0]
        ]
      },
      "sections": {
        "verse": {
          "bars": 4,
          "chordContext": ["C", "F", "G", "C"],
          "layers": {
            "melody": {
              "basePattern": "melody_base",
              "variations": {
                "bar2": "melody_variation",
                "bar4": [[1.0, "G4", 0.9, 4.0]]
              }
            },
            "bass": {
              "basePattern": "bass_walking",
              "variations": {
                "bar3": [[1.0, {"tone": 5, "octave": 2}, 0.8, 1.0], [2.0, {"tone": 1, "octave": 3}, 0.7, 1.0]]
              }
            },
            "harmony": {
              "basePattern": "chord_stabs"
            }
          }
        }
      },
      "arrangement": ["verse"]
    },

    "13_multi_bar_timing": {
      "title": "Multi-Bar Timing with Cross-Bar Events",
