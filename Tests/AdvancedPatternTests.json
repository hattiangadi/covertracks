          "bars": 3,
          "layers": {
            "melody": [
              [1.0, "C4", 0.8, 0.33],
              [1.33, "D4", 0.7, 0.33], 
              [1.67, "E4", 0.8, 0.33],
              [2.0, "F4", 0.7, 0.33],
              [5.0, "G4", 0.8, 2.0],
              [7.5, "A4", 0.9, 1.5],
              [9.0, "C5", 0.8, 4.0]
            ],
            "sustain": [
              [1.0, "C3", 0.5, 12.0]
            ]
          }
        }
      }
    },

    "14_nested_chord_contexts": {
