    "16_simultaneous_chord_events": {
      "title": "Simultaneous Chord Events and Voicings",
      "description": "Test multiple notes at same beat position for chord voicings",
      "tempo": 120,
      "chords": {
        "Cmaj7": ["C3", "E3", "G3", "B3"],
        "Am7": ["A3", "C4", "E4", "G4"]
      },
      "patterns": {
        "piano_voicing": [
          [1.0, {"tone": 1, "octave": 3}, 0.7, 2.0],
          [1.0, {"tone": 3, "octave": 4}, 0.6, 2.0],
          [1.0, {"tone": 5, "octave": 4}, 0.6, 2.0],
          [1.0, {"tone": 7, "octave": 4}, 0.5, 2.0],
          [3.0, {"tone": 1, "octave": 3}, 0.7, 2.0],
          [3.0, {"tone": 3, "octave": 4}, 0.6, 2.0],
          [3.0, {"tone": 5, "octave": 4}, 0.6, 2.0],
          [3.0, {"tone": 7, "octave": 4}, 0.5, 2.0]
        ],
        "chord_context": [
          [1.0, {"chord": "Cmaj7"}, 0.5, 4.0],
          [5.0, {"chord": "Am7"}, 0.5, 4.0]
        ]
      },
      "sections": {
        "piano_section": {
          "bars": 8,
          "layers": {
            "chords": {"basePattern": "chord_context"},
            "piano": {
              "basePattern": "piano_voicing",
              "variations": {
                "bar5": "piano_voicing"
              }
            }
          }
        }
      }
    },

