        "Am": ["A3", "C4", "E4", "A4"],
        "F": ["F3", "A3", "C4", "F4"],
        "G": ["G3", "B3", "D4", "G4"]
      },
      "patterns": {
        "chord_progression": [
          [1.0, {"chord": "C"}, 0.6, 4.0],
          [5.0, {"chord": "Am"}, 0.6, 4.0],
          [9.0, {"chord": "F"}, 0.6, 4.0],
          [13.0, {"chord": "G"}, 0.6, 4.0]
        ],
        "adaptive_melody": [
          [1.0, {"tone": 1, "octave": 4}, 0.8, 0.5],
          [1.5, {"tone": 3, "octave": 4}, 0.7, 0.5],
          [2.0, {"tone": 5, "octave": 4}, 0.8, 0.5],
          [2.5, {"tone": 7, "octave": 4}, 0.7, 0.5],
          [3.0, {"tone": 9, "octave": 4}, 0.8, 1.0]
        ],
        "walking_bass": [
          [1.0, {"tone": 1, "octave": 2}, 0.8, 1.0],
          [2.0, {"tone": 3, "octave": 2}, 0.7, 1.0],
          [3.0, {"tone": 5, "octave": 2}, 0.8, 1.0],
          [4.0, {"tone": 7, "octave": 2}, 0.7, 1.0]
        ]
      },
      "sections": {
        "progression": {
          "bars": 16,
          "layers": {
            "chords": {
              "basePattern": "chord_progression"
            },
            "melody": {
              "basePattern": "adaptive_melody",
              "variations": {
                "bar5": "adaptive_melody",
                "bar9": "adaptive_melody", 
                "bar13": "adaptive_melody"
              }
            },
            "bass": {
              "basePattern": "walking_bass",
              "variations": {
                "bar4": [[3.5, {"tone": 7, "octave": 2}, 0.8, 0.5], [4.0, {"tone": 1, "octave": 3}, 0.9, 1.0]],
                "bar8": [[3.5, {"tone": 7, "octave": 2}, 0.8, 0.5], [4.0, {"tone": 1, "octave": 3}, 0.9, 1.0]],
                "bar12": [[3.5, {"tone": 7, "octave": 2}, 0.8, 0.5], [4.0, {"tone": 1, "octave": 3}, 0.9, 1.0]],
                "bar16": [[3.5, {"tone": 7, "octave": 2}, 0.8, 0.5], [4.0, {"tone": 1, "octave": 3}, 0.9, 1.0]]
              }
            }
          }
        }
      }
    },

