int MusicPatternSystem::getBeatsPerBar(const String& timeSignature)
{
    // Default to 4 beats per bar
    int beats = 4;
    
    // Parse time signature (e.g., "4/4", "3/4")
    if (timeSignature.contains("/"))
    {
        StringArray parts;
        parts.addTokens(timeSignature, "/", "");
        if (parts.size() == 2)
        {
            beats = parts[0].getIntValue();
        }
    }
    
    return beats;
}

