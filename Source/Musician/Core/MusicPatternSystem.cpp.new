var MusicPatternSystem::toVar() const
{
    DynamicObject* obj = new DynamicObject();
    
    // Serialize instrument definitions
    DynamicObject* instrumentsObj = new DynamicObject();
    for (const auto& pair : instrumentDefinitions)
    {
        instrumentsObj->setProperty(pair.first, pair.second.toVar());
    }
    obj->setProperty("instruments", var(instrumentsObj));
    
    // Serialize patterns
    DynamicObject* patternsObj = new DynamicObject();
    for (const auto& pair : patterns)
    {
        if (pair.second)
            patternsObj->setProperty(pair.first, pair.second->toVar());
    }
    obj->setProperty("patterns", var(patternsObj));
    
    // Serialize phrases
    DynamicObject* phrasesObj = new DynamicObject();
    for (const auto& pair : phrases)
    {
        if (pair.second)
            phrasesObj->setProperty(pair.first, pair.second->toVar());
    }
    obj->setProperty("phrases", var(phrasesObj));
    
    // Serialize sections
    DynamicObject* sectionsObj = new DynamicObject();
    for (const auto& pair : sections)
    {
        if (pair.second)
            sectionsObj->setProperty(pair.first, pair.second->toVar());
    }
    obj->setProperty("sections", var(sectionsObj));
    
    // Serialize songs
    DynamicObject* songsObj = new DynamicObject();
    for (const auto& pair : songs)
    {
        if (pair.second)
            songsObj->setProperty(pair.first, pair.second->toVar());
    }
    obj->setProperty("songs", var(songsObj));
    
    return var(obj);
}

bool MusicPatternSystem::fromVar(const var& v)
{
    if (!v.isObject())
        return false;
    
    // Clear existing data
    instrumentDefinitions.clear();
    patterns.clear();
    phrases.clear();
    sections.clear();
    songs.clear();
    
    // Deserialize instrument definitions
    var instrumentsVar = v.getProperty("instruments", var());
    if (instrumentsVar.isObject())
    {
        DynamicObject* instrumentsObj = instrumentsVar.getDynamicObject();
        if (instrumentsObj)
        {
            for (auto& prop : instrumentsObj->getProperties())
            {
                InstrumentDefinition def = InstrumentDefinition::fromVar(prop.value);
                addInstrumentDefinition(prop.name.toString(), def);
            }
        }
    }
    
    // TODO: Deserialize patterns, phrases, sections, and songs
    
    return true;
}

bool MusicPatternSystem::saveToFile(const File& file) const
{
    var data = toVar();
    return JSON::writeToFile(file, data);
}

bool MusicPatternSystem::loadFromFile(const File& file)
{
    var data;
    Result result = JSON::parse(file.loadFileAsString(), data);
    
    if (result.wasOk())
        return fromVar(data);
    
    return false;
}

void MusicPatternSystem::initializeDefaultInstruments()
{
    // Create a basic drum kit
    InstrumentDefinition drums("drums");
    
    // Add drum primitives
    Primitive kick;
    kick.name = "kick";
    kick.midiNote = 36;
    kick.description = "Bass drum";
    drums.addPrimitive("kick", kick);
    
    Primitive snare;
    snare.name = "snare";
    snare.midiNote = 38;
    snare.description = "Snare drum";
    drums.addPrimitive("snare", snare);
    
    Primitive hihat;
    hihat.name = "hihat";
    hihat.midiNote = 42;
    hihat.description = "Closed hi-hat";
    drums.addPrimitive("hihat", hihat);
    
    // Add the drum kit
    addInstrumentDefinition("drums", drums);
    
    // Create a basic piano
    InstrumentDefinition piano("piano");
    
    // Add piano primitives (just a few for example)
    Primitive c3;
    c3.name = "C3";
    c3.midiNote = 48;
    c3.description = "C3 note";
    piano.addPrimitive("C3", c3);
    
    Primitive e3;
    e3.name = "E3";
    e3.midiNote = 52;
    e3.description = "E3 note";
    piano.addPrimitive("E3", e3);
    
    Primitive g3;
    g3.name = "G3";
    g3.midiNote = 55;
    g3.description = "G3 note";
    piano.addPrimitive("G3", g3);
    
    // Add the piano
    addInstrumentDefinition("piano", piano);
}

