namespace covertracks {

// Primitive implementation
var Primitive::toVar() const
{
    DynamicObject* obj = new DynamicObject();
    obj->setProperty("name", name);
    obj->setProperty("midiNote", midiNote);
    obj->setProperty("description", description);
    return var(obj);
}

Primitive Primitive::fromVar(const var& v)
{
    Primitive result;
    if (v.isObject())
    {
        result.name = v.getProperty("name", "").toString();
        result.midiNote = v.getProperty("midiNote", 0);
        result.description = v.getProperty("description", "").toString();
    }
    return result;
}

// PatternEvent implementation
var PatternEvent::toVar() const
{
    DynamicObject* obj = new DynamicObject();
    obj->setProperty("primitive", primitive);
    obj->setProperty("position", position);
    obj->setProperty("duration", duration);
    obj->setProperty("velocity", velocity);
    return var(obj);
}

PatternEvent PatternEvent::fromVar(const var& v)
{
    PatternEvent result;
    if (v.isObject())
    {
        result.primitive = v.getProperty("primitive", "").toString();
        result.position = v.getProperty("position", 0.0);
        result.duration = v.getProperty("duration", 0.25);
        result.velocity = v.getProperty("velocity", 100);
    }
    return result;
}

// InstrumentDefinition implementation
InstrumentDefinition::InstrumentDefinition(const String& name)
    : name(name)
{
}

void InstrumentDefinition::addPrimitive(const String& name, const Primitive& primitive)
{
    primitives[name] = primitive;
}

void InstrumentDefinition::removePrimitive(const String& name)
{
    primitives.erase(name);
}

void InstrumentDefinition::addPattern(const String& name, std::shared_ptr<Bar> pattern)
{
    patterns[name] = pattern;
}

void InstrumentDefinition::removePattern(const String& name)
{
    patterns.erase(name);
}

Primitive InstrumentDefinition::getPrimitive(const String& name) const
{
    auto it = primitives.find(name);
    if (it != primitives.end())
        return it->second;
    
    return Primitive(); // Return empty primitive if not found
}

std::shared_ptr<Bar> InstrumentDefinition::getPattern(const String& name) const
{
    auto it = patterns.find(name);
    if (it != patterns.end())
        return it->second;
    
    return nullptr; // Return nullptr if not found
}

var InstrumentDefinition::toVar() const
{
    DynamicObject* obj = new DynamicObject();
    obj->setProperty("name", name);
    
    // Serialize primitives
    DynamicObject* primitivesObj = new DynamicObject();
    for (const auto& pair : primitives)
    {
        primitivesObj->setProperty(pair.first, pair.second.toVar());
    }
    obj->setProperty("primitives", var(primitivesObj));
    
    // Serialize patterns
    DynamicObject* patternsObj = new DynamicObject();
    for (const auto& pair : patterns)
    {
        if (pair.second)
            patternsObj->setProperty(pair.first, pair.second->toVar());
    }
    obj->setProperty("patterns", var(patternsObj));
    
    return var(obj);
}

InstrumentDefinition InstrumentDefinition::fromVar(const var& v)
{
    InstrumentDefinition result;
    
    if (v.isObject())
    {
        result.name = v.getProperty("name", "").toString();
        
        // Deserialize primitives
        var primitivesVar = v.getProperty("primitives", var());
        if (primitivesVar.isObject())
        {
            DynamicObject* primitivesObj = primitivesVar.getDynamicObject();
            if (primitivesObj)
            {
                for (auto& prop : primitivesObj->getProperties())
                {
                    Primitive primitive = Primitive::fromVar(prop.value);
                    result.addPrimitive(prop.name.toString(), primitive);
                }
            }
        }
        
        // Deserialize patterns
        var patternsVar = v.getProperty("patterns", var());
        if (patternsVar.isObject())
        {
            DynamicObject* patternsObj = patternsVar.getDynamicObject();
            if (patternsObj)
            {
                for (auto& prop : patternsObj->getProperties())
                {
                    auto bar = Bar::fromVar(prop.value);
                    if (bar)
                        result.addPattern(prop.name.toString(), bar);
                }
            }
        }
    }
    
    return result;
}

// MusicPatternSystem implementation
MusicPatternSystem::MusicPatternSystem()
    : defaultInstrument("default")
{
    initializeDefaultInstruments();
}

MusicPatternSystem::~MusicPatternSystem()
{
    // Clean up resources
}

void MusicPatternSystem::addInstrumentDefinition(const String& name, const InstrumentDefinition& definition)
{
    instrumentDefinitions[name] = definition;
}

bool MusicPatternSystem::hasInstrumentDefinition(const String& name) const
{
    return instrumentDefinitions.find(name) != instrumentDefinitions.end();
}

const InstrumentDefinition& MusicPatternSystem::getInstrumentDefinition(const String& name) const
{
    auto it = instrumentDefinitions.find(name);
    if (it != instrumentDefinitions.end())
        return it->second;
    
    return defaultInstrument;
}

std::shared_ptr<Bar> MusicPatternSystem::resolvePatternReference(const String& reference, const String& instrumentName)
{
    // Check if it's a direct pattern ID
    if (hasPattern(reference))
        return getPattern(reference);
    
    // Check if it's an instrument-specific pattern
    if (!instrumentName.isEmpty() && hasInstrumentDefinition(instrumentName))
    {
        const auto& instrument = getInstrumentDefinition(instrumentName);
        if (instrument.hasPattern(reference))
            return instrument.getPattern(reference);
    }
    
    // Check all instruments
    for (const auto& pair : instrumentDefinitions)
    {
        if (pair.second.hasPattern(reference))
            return pair.second.getPattern(reference);
    }
    
    // Not found
    return nullptr;
}

